package com.wipro.core_java_handons.sorting;

public class BubbleSort {

    public static void main(String[] args) {

        // repeatedly swapping adjacent elements
        // swapping adjacent elements

        // outer pass

            // inter pass (j-i-1) - exlude the last element
    BubbleSort bs = new BubbleSort();
    bs.bidirectionalBubbleSort();

    bs.standardBubbleSort();

    }

    public void bidirectionalBubbleSort() {
        int arr[] = {1,92,23,74,25,64,75,68,19,20};
        for(int num : arr) {
            System.out.print(num+ " ");
        }
        boolean swapped = true;
        int start = 0;
        int end = arr.length-1;

        while (swapped) {
            swapped=false;
            for(int i = start; i< end; i++) {
                // outer pass
                if(arr[i]>arr[i+1]) {
                    int temp = arr[i];
                    arr[i] = arr[i+1];
                    arr[i+1] = temp;
                    swapped=true;
                }
            }

            if(!swapped) break;
            swapped=false;
            end--;

            for(int i = end; i>=start; i--) {
                if(arr[i]>arr[i+1]) {
                    int temp = arr[i];
                    arr[i] = arr[i+1];
                    arr[i+1] = temp;
                    swapped=true;
                }
            }
            start++;
        }
        System.out.println();
        for(int num : arr) {
            System.out.print(num+ " ");
        }
    }

    public void standardBubbleSort() {
        int arr[] = {5,1,4,2,8};
        for(int num : arr) {
            System.out.print(num+ " ");
        }
        int n = arr.length;
        boolean swapped;
        for(int i=0; i < n-1; i++) {
            swapped=false;
            // after each outer pass
            // - largest element is shifted to the last pos - so ignore

            for(int j=0; j<n-i-1; j++){
                if(arr[j]>arr[j+1]) {
                    int temp = arr[j];
                    arr[j]=arr[j+1];
                    arr[j+1]=temp;
                    swapped=true;
                }   
            }
            if(!swapped) {
                break;
            }
        }
        for(int num : arr) {
            System.out.print(num+ " ");
        }
    }
}
